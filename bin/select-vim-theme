#!/usr/bin/env python3
import argparse
import curses
import os
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path

from picker_ui import add_text


HOME = Path.home()
THEME_FILE = Path(os.environ.get("VIM_THEME_FILE", HOME / ".vim/theme.vim"))
PREVIEW = os.environ.get("VIM_THEME_PREVIEW", "true") != "false"
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_THEME_DIR = Path(os.environ.get("VIM_THEME_SOURCE_DIR", SCRIPT_DIR.parent / "themes"))
PLUG_VIM = HOME / ".vim/autoload/plug.vim"
PLUG_VIM_SOURCE = Path(
    os.environ.get("VIM_PLUG_SOURCE_DIR", HOME / ".vim/vim-plug")
)


DARK_THEMES = [
    "molokai",
    "gruvbox",
    "dracula",
    "solarized",
    "onedark",
    "PaperColor",
    "ayu",
    "seoul256",
    "jellybeans",
    "nord",
    "everforest",
    "gruvbox-material",
    "edge",
    "sonokai",
    "iceberg",
    "one",
    "tender",
    "moonfly",
    "nightfly",
    "falcon",
]

LIGHT_THEMES = [
    "PaperColor",
    "solarized",
    "ayu",
    "seoul256-light",
    "everforest",
    "gruvbox-material",
    "edge",
    "one",
]


@dataclass(frozen=True)
class Theme:
    name: str
    background: str


def die(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)


def check_vim():
    if not shutil.which("vim"):
        die("vim is required")


def runtime_path():
    tmp_runtime = Path(tempfile.mkdtemp(prefix="vim-theme-runtime-"))
    colors = tmp_runtime / "colors"
    colors.mkdir(parents=True, exist_ok=True)
    if REPO_THEME_DIR.is_dir():
        for path in REPO_THEME_DIR.glob("*.vim"):
            shutil.copy2(path, colors / path.name)

    paths = [str(tmp_runtime)]
    for pattern in (HOME / ".vim/plugged/*", HOME / ".vim/pack/*/start/*"):
        for path in sorted(HOME.glob(str(pattern).replace(str(HOME) + "/", ""))):
            if path.is_dir():
                paths.append(str(path))
    return tmp_runtime, ",".join(paths)


def available_colorschemes(runtimepath):
    with tempfile.NamedTemporaryFile(delete=False) as out:
        output = Path(out.name)
    try:
        subprocess.run(
            [
                "vim",
                "-Nu",
                "NONE",
                "-n",
                "-es",
                "+set nomore",
                f"+set runtimepath^={runtimepath}",
                f"+call writefile(getcompletion('', 'color'), '{output}')",
                "+qa",
            ],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return {line.strip() for line in output.read_text(encoding="utf-8").splitlines() if line.strip()}
    finally:
        output.unlink(missing_ok=True)


def curated_themes(available):
    themes = []
    missing = {}
    for background, wanted in (("dark", DARK_THEMES), ("light", LIGHT_THEMES)):
        missing[background] = []
        for name in wanted:
            if name in available:
                themes.append(Theme(name, background))
            else:
                missing[background].append(name)
    return themes, missing


def draw(stdscr, title, items, selected, detail, query=""):
    stdscr.erase()
    height, width = stdscr.getmaxyx()
    add_text(stdscr, 0, 2, title, width - 4, curses.A_BOLD)
    add_text(stdscr, 0, max(0, width - 54), "/ search  p preview  i install  Right/Enter save", 52)
    if height < 10 or width < 70:
        add_text(stdscr, 2, 2, "Terminal is too small.", width - 4)
        stdscr.refresh()
        return
    left_w = max(28, width // 3)
    for row in range(1, height - 1):
        add_text(stdscr, row, left_w, "|", 1)

    if query:
        add_text(stdscr, 1, 2, f"Search: {query}", left_w - 4, curses.A_BOLD)
        offset = 1
    else:
        offset = 0

    visible = max(0, height - 2 - offset)
    start = max(0, selected - visible + 1)
    for screen_idx, item in enumerate(items[start : start + visible]):
        idx = start + screen_idx
        attr = curses.A_REVERSE if idx == selected else curses.A_NORMAL
        label = f"{item.background:<5} {item.name}"
        add_text(stdscr, screen_idx + 1 + offset, 2, ("> " if idx == selected else "  ") + label, left_w - 4, attr)

    row = 2
    for line in detail:
        if row >= height - 1:
            break
        add_text(stdscr, row, left_w + 2, line, width - left_w - 4)
        row += 1
    stdscr.refresh()


def filter_themes(themes, query):
    if not query:
        return themes
    q = query.lower()
    return [theme for theme in themes if q in theme.name.lower() or q in theme.background.lower()]


def write_theme(theme):
    THEME_FILE.parent.mkdir(parents=True, exist_ok=True)
    THEME_FILE.write_text(f"set background={theme.background}\ncolorscheme {theme.name}\n", encoding="utf-8")


def preview_theme(theme, runtimepath):
    preview_vimrc = Path(tempfile.mkstemp(prefix="vim-theme-preview-", suffix=".vimrc")[1])
    preview_file = Path(tempfile.mkstemp(prefix="vim-theme-preview-", suffix=".vim")[1])
    try:
        preview_vimrc.write_text(
            f"""set nocompatible
set runtimepath^={runtimepath}
syntax on
if has('termguicolors')
    set termguicolors
endif
set background={theme.background}
colorscheme {theme.name}
set number
set relativenumber
set laststatus=2
set statusline=Theme:\\ {theme.name}\\ ({theme.background})
""",
            encoding="utf-8",
        )
        preview_file.write_text(
            """" Theme preview
function! PreviewTheme(name)
    if a:name ==# ''
        echo 'No theme selected'
    endif
endfunction

let s:items = ['vim', 'tmux', 'fzf', 'zsh']
for item in s:items
    echom item
endfor
""",
            encoding="utf-8",
        )
        subprocess.run(["vim", "-Nu", str(preview_vimrc), "-n", str(preview_file)], check=False)
    finally:
        preview_vimrc.unlink(missing_ok=True)
        preview_file.unlink(missing_ok=True)


def run_plug_install():
    if not PLUG_VIM.exists():
        if PLUG_VIM_SOURCE.exists() and not (PLUG_VIM_SOURCE / ".git").is_dir():
            die(f"{PLUG_VIM_SOURCE} exists but is not a Git checkout")
        if (PLUG_VIM_SOURCE / ".git").is_dir():
            subprocess.run(
                [
                    "git",
                    "-C",
                    str(PLUG_VIM_SOURCE),
                    "fetch",
                    "--depth",
                    "1",
                    "origin",
                    "master",
                ],
                check=True,
            )
            subprocess.run(
                ["git", "-C", str(PLUG_VIM_SOURCE), "checkout", "--detach", "FETCH_HEAD"],
                check=True,
            )
        else:
            PLUG_VIM_SOURCE.parent.mkdir(parents=True, exist_ok=True)
            subprocess.run(
                [
                    "git",
                    "clone",
                    "--depth",
                    "1",
                    "https://github.com/junegunn/vim-plug.git",
                    str(PLUG_VIM_SOURCE),
                ],
                check=True,
            )
        PLUG_VIM.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(PLUG_VIM_SOURCE / "plug.vim", PLUG_VIM)
    subprocess.run(["vim", "+PlugInstall --sync", "+qa"], check=False)


def picker(stdscr, themes, missing, runtimepath):
    curses.curs_set(0)
    curses.noecho()
    curses.cbreak()
    stdscr.keypad(True)
    selected = 0
    query = ""
    message = ""

    while True:
        shown = filter_themes(themes, query)
        if shown:
            selected = min(selected, len(shown) - 1)
            theme = shown[selected]
            detail = [
                f"Theme: {theme.name}",
                f"Background: {theme.background}",
                "",
                "Right/Enter saves.",
                "p previews in Vim.",
                "/ searches by theme or background.",
                "i runs PlugInstall for missing popular themes.",
                "q quits.",
                "",
                f"Missing dark: {len(missing['dark'])}",
                f"Missing light: {len(missing['light'])}",
            ]
        else:
            selected = 0
            theme = None
            detail = [
                "No themes match the current search.",
                "",
                "Backspace edits search.",
                "Esc clears search.",
                "i runs PlugInstall.",
            ]
        if message:
            detail += ["", message]

        draw(stdscr, "Vim Themes", shown, selected, detail, query)
        key = stdscr.getch()
        message = ""
        if key in (ord("q"),):
            return
        if key in (27,):
            query = ""
        elif key in (curses.KEY_UP, ord("k")) and shown:
            selected = (selected - 1) % len(shown)
        elif key in (curses.KEY_DOWN, ord("j")) and shown:
            selected = (selected + 1) % len(shown)
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            query = query[:-1]
            selected = 0
        elif key == ord("/"):
            curses.echo()
            add_text(stdscr, 1, 2, "Search: " + " " * 40, 48, curses.A_BOLD)
            stdscr.move(1, 10)
            query = stdscr.getstr(1, 10, 40).decode(errors="ignore")
            curses.noecho()
            selected = 0
        elif key == ord("i"):
            curses.def_prog_mode()
            curses.endwin()
            try:
                run_plug_install()
                input("\nPress Enter to return to the picker...")
            finally:
                curses.reset_prog_mode()
                curses.curs_set(0)
                stdscr.keypad(True)
            return "reload"
        elif key == ord("p") and theme:
            if PREVIEW:
                curses.def_prog_mode()
                curses.endwin()
                try:
                    preview_theme(theme, runtimepath)
                finally:
                    curses.reset_prog_mode()
                    curses.curs_set(0)
                    stdscr.keypad(True)
            message = f"Previewed {theme.name}."
        elif key in (curses.KEY_RIGHT, ord("l"), curses.KEY_ENTER, 10, 13) and theme:
            write_theme(theme)
            message = f"Saved {THEME_FILE}"


def theme_by_name(themes, name, background=None):
    for theme in themes:
        if theme.name == name and (background is None or theme.background == background):
            return theme
    die(f"Theme not available: {name}")


def main():
    parser = argparse.ArgumentParser(description="Vim theme picker")
    parser.add_argument("--list", action="store_true", help="list available themes")
    parser.add_argument("--save", metavar="THEME", help="save a theme without opening the UI")
    parser.add_argument("--background", choices=["dark", "light"], help="background for --save")
    args = parser.parse_args()

    check_vim()
    tmp_runtime = None
    try:
        tmp_runtime, rtp = runtime_path()
        available = available_colorschemes(rtp)
        themes, missing = curated_themes(available)
        if args.list:
            for theme in themes:
                print(f"{theme.background}\t{theme.name}")
            return
        if args.save:
            theme = theme_by_name(themes, args.save, args.background)
            write_theme(theme)
            print(f"Saved {THEME_FILE}")
            return
        while True:
            result = curses.wrapper(picker, themes, missing, rtp)
            if result != "reload":
                break
            shutil.rmtree(tmp_runtime, ignore_errors=True)
            tmp_runtime, rtp = runtime_path()
            available = available_colorschemes(rtp)
            themes, missing = curated_themes(available)
    finally:
        if tmp_runtime is not None:
            shutil.rmtree(tmp_runtime, ignore_errors=True)


if __name__ == "__main__":
    main()
